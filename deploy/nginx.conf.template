# nginx(T-29). ${PUBLIC_HOST}는 컨테이너 시작 때 환경 변수로 채워진다(nginx 공식 이미지의 templates 기능).
# 프론트·/api·/ws·/ai를 한 출처로 받는다: Refresh 쿠키가 SameSite=Strict·Secure·Path=/api/v1/auth라 같은 출처·HTTPS가 필요하다.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 요청 한도(T-32, 보안 점검 H-3). IP 기준이라 같은 공인 IP(시연장 와이파이) 뒤의 여러 사람이 함께 쓴다 — 넉넉히 잡는다.
# - guest: 계정을 만드는 POST /api/v1/auth/guest만. 재발급·로그아웃은 Refresh 쿠키가 있어야 해 제외(페이지를 열 때마다 불림)
# - create: 방·경기 생성(POST /api/v1/rooms, /api/v1/matches). 같은 경로의 GET은 키가 비어 제한하지 않는다
# - ai: AI 수 요청. 초과(429)면 화면이 규칙 AI로 대신 둔다(FR-AI-02 대체 경로)
# - ws: IP별 동시 WebSocket 연결 수
map $request_method $create_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone  $binary_remote_addr zone=guest:10m  rate=30r/m;
limit_req_zone  $create_limit_key   zone=create:10m rate=60r/m;
limit_req_zone  $binary_remote_addr zone=ai:10m     rate=20r/s;
limit_conn_zone $binary_remote_addr zone=ws_conn:10m;
limit_req_status  429;
limit_conn_status 429;

server {
    listen 80;
    server_name ${PUBLIC_HOST};

    # Let's Encrypt 발급·갱신 확인 경로
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /api/v1/auth/guest {
        limit_req zone=guest burst=50 nodelay;
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/api/v1/(rooms|matches)$ {
        limit_req zone=create burst=20 nodelay;
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # STOMP over WebSocket
    location /ws {
        limit_conn ws_conn 60;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;   # STOMP 하트비트(서버 10초·클라이언트 25초, 보안 점검 M-2)가 오가므로 이보다 오래 조용하면 죽은 연결이다
        proxy_send_timeout 90s;
    }

    location /ai/ {
        limit_req zone=ai burst=40 nodelay;
        proxy_pass http://ai:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # 빌드 산출물은 파일 이름에 해시가 붙어 오래 캐시해도 된다
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 화면은 해시 라우터. 초대 링크(/room/{code})처럼 파일이 없는 경로도 index.html을 준다
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
